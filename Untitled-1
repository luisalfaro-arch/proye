
from IPython.display import HTML, display

display(HTML(r"""
<div id="tetris" style="font-family:Arial;text-align:center;background:#111827;color:white;padding:18px;border-radius:14px;max-width:500px;margin:auto">
  <h2 style="margin:0 0 8px;color:#38bdf8">🎮 TETRIS</h2>
  <div style="display:flex;justify-content:center;gap:24px;margin:10px">
    <b>Puntos: <span id="score">0</span></b>
    <b>Nivel: <span id="level">1</span></b>
    <b>Líneas: <span id="lines">0</span></b>
  </div>
  <canvas id="board" width="300" height="600" tabindex="0"
    style="width:min(100%,300px);height:auto;background:#080d18;border:2px solid #475569;border-radius:5px;outline:none"></canvas>
  <div id="message" style="margin:10px;font-weight:bold;color:#fbbf24">Haz clic en el tablero para jugar</div>
  <div style="display:flex;justify-content:center;gap:8px;flex-wrap:wrap">
    <button onclick="gameStart()" style="padding:10px 16px">🔄 Reiniciar</button>
    <button onclick="togglePause()" style="padding:10px 16px">⏸ Pausar</button>
  </div>
  <p style="font-size:13px;color:#cbd5e1;line-height:1.8">
    ⬅️ ➡️ Mover | ⬇️ Bajar<br>
    ⬆️ Girar pieza | ESPACIO: caída rápida | P: pausa
  </p>
  <div style="display:flex;justify-content:center;gap:10px">
    <button onclick="move(-1,0)">⬅️</button>
    <button onclick="rotate()">🔄 Girar</button>
    <button onclick="move(1,0)">➡️</button>
    <button onclick="move(0,1)">⬇️</button>
    <button onclick="hardDrop()">⏬</button>
  </div>
</div>

<script>
(() => {
const root = document.getElementById('tetris');
const canvas = root.querySelector('#board');
const ctx = canvas.getContext('2d');
const W = 10, H = 20, S = 30;
const colors = [null,'#22d3ee','#3b82f6','#f97316','#facc15',
                '#a855f7','#22c55e','#ef4444'];

const shapes = [
  [[1,1,1,1]],
  [[2,0,0],[2,2,2]],
  [[0,0,3],[3,3,3]],
  [[4,4],[4,4]],
  [[0,5,5],[5,5,0]],
  [[0,6,0],[6,6,6]],
  [[7,7,0],[0,7,7]]
];

let board, piece, score, lines, level, over, paused, running;
let timer = null, last = 0, acc = 0;

function newPiece() {
  const shape = shapes[Math.floor(Math.random()*shapes.length)];
  return {
    matrix: shape.map(r=>r.slice()),
    x: Math.floor((W-shape[0].length)/2),
    y: 0,
    color: shapes.indexOf(shape)+1
  };
}

function collide(p, dx=0, dy=0, matrix=p.matrix) {
  for(let y=0;y<matrix.length;y++)
    for(let x=0;x<matrix[y].length;x++) {
      if(!matrix[y][x]) continue;
      let nx=p.x+x+dx, ny=p.y+y+dy;
      if(nx<0 || nx>=W || ny>=H) return true;
      if(ny>=0 && board[ny][nx]) return true;
    }
  return false;
}

function spawn() {
  piece = newPiece();
  if(collide(piece)) {
    over = true;
    running = false;
    root.querySelector('#message').textContent =
      '🎮 ¡Juego terminado! Pulsa Reiniciar';
  }
}

function merge() {
  piece.matrix.forEach((row,y)=>row.forEach((v,x)=>{
    if(v && piece.y+y>=0) board[piece.y+y][piece.x+x]=piece.color;
  }));
}

function sweep() {
  let cleared=0;
  for(let y=H-1;y>=0;y--) {
    if(board[y].every(Boolean)) {
      board.splice(y,1);
      board.unshift(Array(W).fill(0));
      cleared++;
      y++;
    }
  }
  if(cleared) {
    lines += cleared;
    score += [0,100,300,500,800][cleared]*level;
    level = Math.floor(lines/10)+1;
  }
  updateStats();
}

function move(dx,dy) {
  if(!running || paused || over) return;
  if(!collide(piece,dx,dy)) {
    piece.x+=dx; piece.y+=dy;
  } else if(dy===1) {
    merge(); sweep(); spawn();
  }
  draw();
}

function rotate() {
  if(!running || paused || over) return;
  const m=piece.matrix;
  const rotated=m[0].map((_,i)=>m.map(row=>row[i]).reverse());
  for(const kick of [0,-1,1,-2,2]) {
    if(!collide(piece,kick,0,rotated)) {
      piece.x+=kick; piece.matrix=rotated; break;
    }
  }
  draw();
}

function hardDrop() {
  if(!running || paused || over) return;
  let dist=0;
  while(!collide(piece,0,1)) {piece.y++;dist++;}
  score+=dist*2;
  merge(); sweep(); spawn(); updateStats(); draw();
}

function updateStats() {
  root.querySelector('#score').textContent=score;
  root.querySelector('#lines').textContent=lines;
  root.querySelector('#level').textContent=level;
}

function draw() {
  ctx.fillStyle='#080d18';
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.strokeStyle='#1e293b';
  ctx.lineWidth=.5;
  for(let y=0;y<H;y++) for(let x=0;x<W;x++) {
    ctx.strokeRect(x*S,y*S,S,S);
    if(board[y][x]) cell(x,y,colors[board[y][x]]);
  }
  if(piece) piece.matrix.forEach((row,y)=>row.forEach((v,x)=>{
    if(v) cell(piece.x+x,piece.y+y,colors[piece.color]);
  }));
  if(paused || over) {
    ctx.fillStyle='rgba(0,0,0,.72)';
    ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle='#ffffff';
    ctx.textAlign='center';
    ctx.font='bold 23px Arial';
    ctx.fillText(over?'GAME OVER':'PAUSA',150,285);
  }
}

function cell(x,y,color) {
  ctx.fillStyle=color;
  ctx.fillRect(x*S+1,y*S+1,S-2,S-2);
  ctx.fillStyle='rgba(255,255,255,.22)';
  ctx.fillRect(x*S+3,y*S+3,S-6,4);
}

function loop(time=0) {
  if(!running) return;
  const dt=Math.min(time-last,100);
  last=time;
  if(!paused && !over) {
    acc+=dt;
    if(acc>Math.max(90,750-(level-1)*55)) {
      if(!collide(piece,0,1)) piece.y++;
      else {merge();sweep();spawn();}
      acc=0;
      draw();
    }
  }
  timer=requestAnimationFrame(loop);
}

function gameStart() {
  if(timer!==null) cancelAnimationFrame(timer);
  board=Array.from({length:H},()=>Array(W).fill(0));
  score=0;lines=0;level=1;over=false;paused=false;
  running=true;acc=0;last=0;
  root.querySelector('#message').textContent='¡A jugar!';
  updateStats();spawn();draw();
  timer=requestAnimationFrame(loop);
}

function togglePause() {
  if(over || !running) return;
  paused=!paused;
  root.querySelector('#message').textContent=paused?'Juego pausado':'¡A jugar!';
  draw();
}

document.addEventListener('keydown',e=>{
  if(!root.isConnected) return;
  if(['ArrowLeft','ArrowRight','ArrowDown','ArrowUp',' '].includes(e.key))
    e.preventDefault();
  if(e.key==='ArrowLeft') move(-1,0);
  else if(e.key==='ArrowRight') move(1,0);
  else if(e.key==='ArrowDown') move(0,1);
  else if(e.key==='ArrowUp') rotate();
  else if(e.key===' ') hardDrop();
  else if(e.key.toLowerCase()==='p') togglePause();
});

canvas.addEventListener('click',()=>canvas.focus());
window.gameStart=gameStart;
window.togglePause=togglePause;
window.move=move;
window.rotate=rotate;
window.hardDrop=hardDrop;
gameStart();
})();
</script>
